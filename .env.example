# ==============================================================================
# RoleMed RB-HMS Environment Configuration Template
# ==============================================================================
# Copy this file to `.env.local` for local development or set as environment variables
# in your production container/cloud hosting environment.

# ------------------------------------------------------------------------------
# NextAuth.js Configuration
# ------------------------------------------------------------------------------
# A secure, random 32+ character hex secret used to encrypt JWT session tokens.
# Generate in bash/PowerShell: openssl rand -hex 32
NEXTAUTH_SECRET=replace_with_a_secure_random_32_byte_secret

# The canonical public URL where the application is accessible.
# Local development: http://localhost:3000
# Production: https://hospital.example.com
NEXTAUTH_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# MongoDB Database Connection
# ------------------------------------------------------------------------------
# MongoDB connection string URI including database name.
# Local standalone: mongodb://localhost:27017/rolemed
# Docker compose: mongodb://mongodb:27017/rolemed
# Production Replica Set: mongodb+srv://<user>:<password>@cluster0.mongodb.net/rolemed?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/rolemed

# ------------------------------------------------------------------------------
# Operational Environment & Defaults
# ------------------------------------------------------------------------------
# Environment mode: development | production | test
NODE_ENV=development

# Application default currency standard (Hospital standard: PKR / Rs.)
DEFAULT_CURRENCY=PKR

# ------------------------------------------------------------------------------
# Hospital Email Delivery Configuration (Nodemailer SMTP)
# ------------------------------------------------------------------------------
# For Gmail:
# 1. Enable 2-Step Verification in Google Account > Security.
# 2. Generate a 16-character App Password under "App passwords".
# 3. Set SMTP_SERVICE=gmail and SMTP_PASS to the generated 16-character token.
# SMTP_SERVICE=gmail
# SMTP_USER=hospital.rolemed@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
# SMTP_FROM="RoleMed Healthcare" <hospital.rolemed@gmail.com>

# For Custom SMTP (e.g. Mailtrap, Outlook, Brevo, AWS SES, or Private Hospital Exchange):
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
# SMTP_FROM="RoleMed Healthcare" <notifications@rolemed.org>

